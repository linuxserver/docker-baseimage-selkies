# syntax=docker/dockerfile:1
FROM ghcr.io/linuxserver/baseimage-ubuntu:arm64v8-resolute

# set version label
ARG BUILD_DATE
ARG VERSION
ARG SELKIES_RELEASE
LABEL build_version="Linuxserver.io version:- ${VERSION} Build-date:- ${BUILD_DATE}"
LABEL maintainer="thelamer"

# env
ENV DISPLAY=:1 \
    PERL5LIB=/usr/local/bin \
    HOME=/config \
    START_DOCKER=true \
    SELKIES_INTERPOSER=/usr/lib/selkies_input_interposer.so \
    SELKIES_WEBCAM_INTERPOSER=/usr/lib/selkies_v4l2_interposer.so \
    FAKE_UDEV_LIB=/opt/lib/libudev.so.1.0.0-fake \
    NVIDIA_DRIVER_CAPABILITIES=all \
    DISABLE_DRI3=false \
    SELKIES_ENCODER="h264enc,h265enc,vp8enc,vp9enc,av1enc,jpeg" \
    SELKIES_ENABLE_BASIC_AUTH=false \
    SELKIES_VIDEO_STREAMING_MODE=false \
    SELKIES_ALLOWED_ORIGINS="*" \
    SELKIES_APP_LOGS=false \
    SELKIES_RATE_CONTROL_MODE="crf,cbr" \
    SHELL=/bin/bash \
    TITLE=Selkies

RUN \
  echo "**** enable locales ****" && \
  sed -i \
    '/locale/d' \
    /etc/dpkg/dpkg.cfg.d/excludes && \
  echo "**** exclude extra cjk fonts ****" && \
  printf '%s\n' \
    'path-exclude=/usr/share/fonts/opentype/noto/NotoSerifCJK-*' \
    'path-exclude=/usr/share/fonts/opentype/noto/NotoSansCJK-Bold.ttc' \
    > /etc/dpkg/dpkg.cfg.d/selkies-fonts && \
  echo "**** install deps ****" && \
  curl -fsSL https://deb.nodesource.com/setup_22.x | bash - && \
  apt-get update && \
  DEBIAN_FRONTEND=noninteractive apt-get install --no-install-recommends -y \
    at-spi2-core \
    bash-completion \
    breeze-cursor-theme \
    breeze-icon-theme \
    ca-certificates \
    console-data \
    cups-client \
    dbus-x11 \
    file \
    fonts-noto-cjk \
    fonts-noto-color-emoji \
    fonts-noto-core \
    foot \
    fuse-overlayfs \
    gir1.2-atspi-2.0 \
    git \
    gtk-update-icon-cache \
    gvfs \
    gvfs-daemons \
    htop \
    iproute2 \
    iptables \
    iputils-ping \
    kbd \
    less \
    libatk1.0-0 \
    libatk-bridge2.0-0 \
    libegl1 \
    libegl-mesa0 \
    libev4 \
    libfontenc1 \
    libfreetype6 \
    libgbm1 \
    libgcrypt20 \
    libgirepository-1.0-1 \
    libgl1-mesa-dri \
    libgles2 \
    libglib2.0-bin \
    libglu1-mesa \
    libgnutls30 \
    libgtk-3.0 \
    libjpeg-turbo8 \
    libnotify-bin \
    libnss3 \
    libnvidia-egl-wayland1 \
    libnvidia-egl-gbm1 \
    libnvidia-egl-xcb1 \
    libnvidia-egl-xlib1 \
    libopus0 \
    libp11-kit0 \
    libpam0g \
    libtasn1-6 \
    libva-drm2 \
    libvulkan1 \
    libwayland-client0 \
    libwayland-cursor0 \
    libwayland-egl1 \
    libwayland-server0 \
    libx11-6 \
    libx264-165 \
    libxau6 \
    libxcb1 \
    libxcb-icccm4 \
    libxcb-image0 \
    libxcb-keysyms1 \
    libxcb-render-util0 \
    libxcursor1 \
    libxdmcp6 \
    libxext6 \
    libxfconf-0-3 \
    libxfixes3 \
    libxfont2 \
    libxinerama1 \
    libxkbcommon-dev \
    libxkbcommon-x11-0 \
    libxshmfence1 \
    libxtst6 \
    locales \
    mesa-libgallium \
    mesa-va-drivers \
    mesa-vulkan-drivers \
    openssh-client \
    openssl \
    pciutils \
    procps \
    psmisc \
    pulseaudio-utils \
    python3 \
    python3-gi \
    rsync \
    software-properties-common \
    ssl-cert \
    sudo \
    tar \
    tree \
    unzip \
    vainfo \
    util-linux \
    vim-tiny \
    vulkan-tools \
    wget \
    wl-clipboard \
    x11-apps \
    x11-common \
    x11-utils \
    x11-xkb-utils \
    x11-xserver-utils \
    xauth \
    xclip \
    xcvt \
    xdg-utils \
    xdotool \
    xfce4-terminal \
    xfconf \
    xfonts-base \
    xkb-data \
    xsel \
    xterm \
    xutils \
    zip \
    zlib1g \
    zstd && \
  echo "**** add icon ****" && \
  mkdir -p \
    /usr/share/selkies/www && \
  curl -o \
    /usr/share/selkies/www/icon.png \
    https://raw.githubusercontent.com/linuxserver/docker-templates/master/linuxserver.io/img/selkies-logo.png && \
  curl -o \
    /usr/share/selkies/www/favicon.ico \
    https://raw.githubusercontent.com/linuxserver/docker-templates/refs/heads/master/linuxserver.io/img/selkies-icon.ico && \
  echo "**** wallpaper ****" && \
  mkdir -p \
    /usr/share/wallpapers/Next/contents/images \
    /usr/share/wallpapers/Next/contents/images_dark && \
  curl -fsSL -o \
    /usr/share/wallpapers/Next/metadata.json \
    https://raw.githubusercontent.com/KDE/breeze/master/wallpapers/Next/metadata.json && \
  curl -fsSL -o \
    /usr/share/wallpapers/Next/contents/images/5120x2880.png \
    https://raw.githubusercontent.com/KDE/breeze/master/wallpapers/Next/contents/images/5120x2880.png && \
  curl -fsSL -o \
    /usr/share/wallpapers/Next/contents/images_dark/5120x2880.png \
    https://raw.githubusercontent.com/KDE/breeze/master/wallpapers/Next/contents/images_dark/5120x2880.png && \
  ln -sf /usr/bin/vim.tiny /usr/bin/vim && \
  echo "**** titlebar buttons for client-side decorations ****" && \
  printf "[org.gnome.desktop.wm.preferences]\nbutton-layout=':minimize,maximize,close'\n" \
    > /usr/share/glib-2.0/schemas/selkies-decoration.gschema.override && \
  glib-compile-schemas /usr/share/glib-2.0/schemas/ && \
  echo "**** user perms ****" && \
  sed -e 's/%sudo	ALL=(ALL:ALL) ALL/%sudo ALL=(ALL:ALL) NOPASSWD: ALL/g' \
    -i /etc/sudoers && \
  echo "abc:abc" | chpasswd && \
  usermod -s /bin/bash abc && \
  usermod -aG sudo abc && \
  echo "**** proot-apps ****" && \
  mkdir /proot-apps/ && \
  PAPPS_RELEASE=$(curl -sX GET "https://api.github.com/repos/linuxserver/proot-apps/releases" \
    | jq -r '[.[] | select(.prerelease == true)][0].tag_name') && \
  curl -L https://github.com/linuxserver/proot-apps/releases/download/${PAPPS_RELEASE}/proot-apps-aarch64.tar.gz \
    | tar -xzf - -C /proot-apps/ && \
  echo "${PAPPS_RELEASE}" > /proot-apps/pversion && \
  echo "**** dind support ****" && \
  useradd -U dockremap && \
  usermod -G dockremap dockremap && \
  echo 'dockremap:165536:65536' >> /etc/subuid && \
  echo 'dockremap:165536:65536' >> /etc/subgid && \
  curl -o \
  /usr/local/bin/dind -L \
    https://raw.githubusercontent.com/moby/moby/master/hack/dind && \
  chmod +x /usr/local/bin/dind && \
  echo 'hosts: files dns' > /etc/nsswitch.conf && \
  groupadd -f docker && \
  usermod -aG docker abc && \
  echo "**** install the selkies bundle ****" && \
  BUNDLE_PATTERN='^selkies-.+-aarch64-linux-gnu[.]tar[.]gz$' && \
  if [ -z "${SELKIES_RELEASE}" ]; then \
    curl -fsSL -o /tmp/selkies-commits.json \
      "https://api.github.com/repos/selkies-project/selkies/commits?sha=main&per_page=100" && \
    curl -fsSL -o /tmp/selkies-releases.json \
      "https://api.github.com/repos/selkies-project/selkies/releases?per_page=100" && \
    SELKIES_RELEASE=$(jq -rn \
      --slurpfile commits /tmp/selkies-commits.json \
      --slurpfile releases /tmp/selkies-releases.json \
      --arg pattern "${BUNDLE_PATTERN}" \
      '[$releases[0][] | select(any(.assets[]; .name | test($pattern))) | .tag_name] as $tags \
       | first($commits[0][].sha as $sha | $tags[] | select(. as $tag | $sha | startswith($tag))) // empty') && \
    rm -f /tmp/selkies-commits.json /tmp/selkies-releases.json; \
  fi && \
  if [ -z "${SELKIES_RELEASE}" ]; then \
    echo "no recent selkies commit on main carries a bundle for this architecture yet" && \
    exit 1; \
  fi && \
  BUNDLE=$(curl -sX GET "https://api.github.com/repos/selkies-project/selkies/releases/tags/${SELKIES_RELEASE}" \
    | jq -r --arg pattern "${BUNDLE_PATTERN}" '.assets[] | select(.name | test($pattern)) | .name') && \
  if [ -z "${BUNDLE}" ] || [ "${BUNDLE}" = "null" ]; then \
    echo "no aarch64 selkies bundle in release ${SELKIES_RELEASE}" && \
    exit 1; \
  fi && \
  echo "selkies ${SELKIES_RELEASE}: ${BUNDLE}" && \
  mkdir -p /tmp/selkies && \
  curl -fsSL -o "/tmp/selkies/${BUNDLE}" \
    "https://github.com/selkies-project/selkies/releases/download/${SELKIES_RELEASE}/${BUNDLE}" && \
  tar -xzf "/tmp/selkies/${BUNDLE}" -C /opt && \
  echo "**** web client on disk for external hosts ****" && \
  SOURCE="${BUNDLE%-*-linux-gnu.tar.gz}.tar.gz" && \
  curl -fsSL -o "/tmp/selkies/${SOURCE}" \
    "https://github.com/selkies-project/selkies/releases/download/${SELKIES_RELEASE}/${SOURCE}" && \
  mkdir -p /usr/share/selkies/web && \
  tar -xzf "/tmp/selkies/${SOURCE}" \
    -C /usr/share/selkies/web \
    --no-same-owner \
    --strip-components=3 \
    --wildcards '*/dist/web/*' && \
  test -f /usr/share/selkies/web/index.html && \
  echo "**** link the selkies bundle ****" && \
  mv /opt/selkies-*-linux-gnu /opt/selkies && \
  ln -s \
    /opt/selkies/bin/selkies \
    /usr/bin/selkies && \
  ln -s \
    /opt/selkies/bin/selkies-desktop \
    /usr/bin/selkies-desktop && \
  mkdir -p /opt/lib && \
  cp \
    /opt/selkies/lib/selkies/preload/selkies_input_interposer.so \
    /usr/lib/selkies_input_interposer.so && \
  cp \
    /opt/selkies/lib/selkies/preload/selkies_v4l2_interposer.so \
    /usr/lib/selkies_v4l2_interposer.so && \
  ln -s \
    selkies_input_interposer.so \
    /usr/lib/selkies_joystick_interposer.so && \
  cp \
    /opt/selkies/lib/selkies/preload/libudev.so.1.0.0-fake \
    /opt/lib/libudev.so.1.0.0-fake && \
  selkies --version && \
  echo "**** cleanup ****" && \
  apt-get autoclean && \
  rm -rf \
    /config/.cache \
    /config/.npm \
    /var/lib/apt/lists/* \
    /var/tmp/* \
    /tmp/*

# add local files
COPY /root /

# ports and volumes
EXPOSE 3000 3001
VOLUME /config
