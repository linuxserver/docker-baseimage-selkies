#!/usr/bin/with-contenv bash

# bail early on wayland
if [[ "${PIXELFLUX_WAYLAND,,}" == "true" ]]; then
  sleep infinity
fi

# Cleanup
rm -f /tmp/.X1-lock

# Kernel driver behind a render node, e.g. i915, amdgpu
node_driver() {
  local drv
  drv="$(readlink -f "/sys/class/drm/$(basename "$1")/device/driver" 2>/dev/null)"
  echo "${drv##*/}"
}

# Pick the render node glamor draws on. DRINODE wins outright
DRI3_NODE=""
if [ -n "${DRINODE}" ]; then
  DRI3_NODE="${DRINODE}"
else
  for node in /dev/dri/renderD*; do
    [ -e "${node}" ] || continue
    DRI3_NODE="${node}"
    break
  done
fi

# Set DRI3 node
VFBCOMMAND=""
if [ "${DISABLE_DRI3,,}" == "false" ] && [ -n "${DRI3_NODE}" ] \
  && /usr/bin/Xvfb -help 2>&1 | grep -q -- '-glamor'; then
  VFBCOMMAND="-glamor -dri ${DRI3_NODE}"
  echo "**** Xvfb using DRI3 on ${DRI3_NODE} ($(node_driver "${DRI3_NODE}")) ****"
fi

# Run Xvfb server with required extensions
exec s6-setuidgid abc \
  /usr/bin/Xvfb \
    "${DISPLAY}" \
    -dpi "96" \
    +extension "COMPOSITE" \
    +extension "DAMAGE" \
    +extension "GLX" \
    +extension "RANDR" \
    +extension "RENDER" \
    +extension "MIT-SHM" \
    +extension "XFIXES" \
    +extension "XTEST" \
    +iglx \
    +render \
    -nolisten "tcp" \
    -ac \
    -shmem \
    ${VFBCOMMAND}
