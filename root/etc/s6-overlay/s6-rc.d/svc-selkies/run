#!/usr/bin/with-contenv bash

# interposers are for session apps, keep them out of the server and drop by value
if [[ -n "${LD_PRELOAD}" ]]; then
  KEPT_PRELOAD=""
  IFS=':' read -ra PRELOADS <<< "${LD_PRELOAD}"
  for preload in "${PRELOADS[@]}"; do
    case "${preload}" in
      ""|"${SELKIES_INTERPOSER}"|"${SELKIES_WEBCAM_INTERPOSER}"|"${FAKE_UDEV_LIB}"|/opt/lib/libudev.so.1.0.0-fake) ;;
      *) KEPT_PRELOAD="${KEPT_PRELOAD:+${KEPT_PRELOAD}:}${preload}" ;;
    esac
  done
  if [[ -n "${KEPT_PRELOAD}" ]]; then
    export LD_PRELOAD="${KEPT_PRELOAD}"
  else
    unset LD_PRELOAD
  fi
fi

# Setup dev mode if defined
if [ ! -z ${DEV_MODE+x} ]; then
  # Dev deps
  apt-get update
  apt-get install -y \
    nodejs
  npm install -g nodemon
  rm -Rf $HOME/.npm
  if [[ "${DEV_MODE}" == "pixelflux" ]]; then
    # Dev deps
    apt-get install -y \
      cargo \
      clang \
      cmake \
      curl \
      g++ \
      gcc \
      git \
      libclang-dev \
      libdav1d-dev \
      libde265-dev \
      libdrm-dev \
      libgbm-dev \
      libinput-dev \
      libpixman-1-dev \
      libsvtav1enc-dev \
      libudev-dev \
      libvpx-dev \
      libwayland-dev \
      libx264-dev \
      libx265-dev \
      libxkbcommon-dev \
      make \
      nasm \
      python3-dev \
      python3-pip \
      python3-setuptools \
      python3-setuptools-rust \
      python3-wheel \
      rustc
    # Run backend watcher
    chown -R abc:abc /lsiopy
    cd /config/src
    s6-setuidgid abc \
      nodemon -V \
      --watch . \
      --ext py,cpp,h,c,rs,toml \
      --ignore "pixelflux_wayland/target/" \
      --ignore "build/" \
      --ignore "*.egg-info/" \
      --ignore "__pycache__/" \
      --exec "pip uninstall -y pixelflux || true && pip install . --break-system-packages && (killall labwc || true) && (killall selkies-desktop || true) && cd /tmp && python3 -m selkies --addr='localhost' --debug='true'"
  else
    # Frontend setup
    if [[ "${DEV_MODE}" == "core" ]]; then
      # Core just runs from directory
      cd $HOME/src/addons/selkies-web-core
      s6-setuidgid abc npm install
      s6-setuidgid abc npm run serve &
    else
      # Build core
      cd $HOME/src/addons/selkies-web-core
      s6-setuidgid abc npm install
      s6-setuidgid abc npm run build
      s6-setuidgid abc cp dist/selkies-core.js ../${DEV_MODE}/src/
      s6-setuidgid abc nodemon \
        --watch . \
        --ext js,html \
        --ignore dist/ \
        --ignore node_modules/ \
        --exec "npm run build && cp dist/selkies-core.js ../${DEV_MODE}/src/" &
      # Copy touch gamepad
      s6-setuidgid abc cp ../universal-touch-gamepad/universalTouchGamepad.js ../${DEV_MODE}/src/
      s6-setuidgid abc nodemon \
        --watch ../universal-touch-gamepad/universalTouchGamepad.js \
        --exec "cp ../universal-touch-gamepad/universalTouchGamepad.js ../${DEV_MODE}/src/" &
      # Copy themes
      s6-setuidgid abc cp -a nginx ../${DEV_MODE}/
      # Run passed frontend
      cd $HOME/src/addons/${DEV_MODE}
      s6-setuidgid abc npm install
      s6-setuidgid abc npm run serve &
    fi
    # Run backend
    cd $HOME/src/src
    s6-setuidgid abc \
      nodemon -V --ext py --watch . --exec \
        "killall labwc || true; killall selkies-desktop || true; python3 -m selkies --addr='localhost' --debug='true'"
  fi
fi

# listen and auth flags
LISTEN="--public"
if [ -n "${DISABLE_IPV6}" ]; then
  LISTEN="--addr=0.0.0.0"
fi
AUTH=""
if [ -n "${PASSWORD}" ]; then
  AUTH="--enable-basic-auth=true"
fi

# Start Selkies
exec s6-setuidgid abc \
  selkies session \
    --runtime-dir="${XDG_RUNTIME_DIR}" \
    --session="bash /defaults/startwm.sh" \
    --wayland-session="bash /defaults/startwm_wayland.sh" \
    ${LISTEN} \
    ${AUTH} \
    --port="${CUSTOM_PORT:-3000}" \
    --https-port="${CUSTOM_HTTPS_PORT:-3001}" \
    --https-cert=/config/ssl/cert.pem \
    --https-key=/config/ssl/cert.key
