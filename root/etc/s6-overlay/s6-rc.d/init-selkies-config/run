#!/usr/bin/with-contenv bash

# selkies reads SELKIES_WAYLAND ahead of PIXELFLUX_WAYLAND, mirror it for scripts keyed on the legacy name
if [[ -n "${SELKIES_WAYLAND}" ]]; then
  WAYLAND_VALUE="${SELKIES_WAYLAND%%|*}"
  if [[ "${WAYLAND_VALUE,,}" == "true" ]] || [[ "${WAYLAND_VALUE}" == "1" ]]; then
    PIXELFLUX_WAYLAND="true"
  else
    PIXELFLUX_WAYLAND="false"
  fi
  printf "${PIXELFLUX_WAYLAND}" > /run/s6/container_environment/PIXELFLUX_WAYLAND
fi

# set paths for wayland or xorg
if [[ "${PIXELFLUX_WAYLAND,,}" == "true" ]];then
  CONF_DIR="$HOME/.config/labwc"
  DEF_AUTOSTART="/defaults/autostart_wayland"
  DEF_RC="/defaults/labwc.xml"
else
  CONF_DIR="$HOME/.config/openbox"
  DEF_AUTOSTART="/defaults/autostart"
fi

# default file copies first run
mkdir -p "$HOME/.config"
chown abc:abc "$HOME/.config"
if [[ ! -f "$CONF_DIR/autostart" ]]; then
  mkdir -p "$CONF_DIR"
  if [[ -f "$DEF_AUTOSTART" ]]; then
    cp "$DEF_AUTOSTART" "$CONF_DIR/autostart"
    chown abc:abc "$CONF_DIR" "$CONF_DIR/autostart"
  fi
fi
# migrate legacy st autostart
if [[ "$(cat "$HOME/.config/openbox/autostart" 2>/dev/null)" == "st" ]]; then
  printf 'xfce4-terminal\n' > "$HOME/.config/openbox/autostart"
fi

# remove unmodified legacy menu.xml, and first run copies of the image's menus, which a home copy would shadow
menu_is_default() {
  case "$(md5sum "$1" 2>/dev/null | cut -d' ' -f1)" in
    c05fbb01c54f7c7d0557e3c5ba459427|9f7fd0b0c65124b95b43787fd9b2b0a3) return 0 ;;
  esac
  cmp -s "$1" /defaults/menu.xml || cmp -s "$1" /defaults/menu_wayland.xml
}
for menu_dir in "$HOME/.config/openbox" "$HOME/.config/labwc"; do
  if [[ -f "$menu_dir/menu.xml.bak" ]] && menu_is_default "$menu_dir/menu.xml.bak"; then
    rm -f "$menu_dir/menu.xml" "$menu_dir/menu.xml.bak"
  elif [[ -f "$menu_dir/menu.xml" ]] && [[ ! -f "$menu_dir/menu.xml.bak" ]] && menu_is_default "$menu_dir/menu.xml"; then
    rm -f "$menu_dir/menu.xml"
  fi
done

# the image's menus, which the selkies window manager puts above its own menu
SYSTEM_MENUS=()
for menu_pair in "menu.xml:openbox" "menu_wayland.xml:labwc"; do
  menu_src="/defaults/${menu_pair%%:*}"
  menu_dst="/etc/xdg/${menu_pair##*:}/menu.xml"
  if [[ -f "$menu_src" ]]; then
    mkdir -p "${menu_dst%/*}"
    cp "$menu_src" "$menu_dst"
    SYSTEM_MENUS+=("$menu_dst")
  fi
done

# XDG Home
printf "$HOME/.XDG" > /run/s6/container_environment/XDG_RUNTIME_DIR
# svc-app-exit takes a new lock file as the sign that the app has started
rm -f "$HOME/.XDG/selkies-autostart.lock"
printf "$HOME/.XDG/Xauthority" > /run/s6/container_environment/XAUTHORITY
if [[ "${PIXELFLUX_WAYLAND,,}" == "true" ]]; then
  printf "wayland-1" > /run/s6/container_environment/WAYLAND_DISPLAY
  printf ":0" > /run/s6/container_environment/DISPLAY
fi
# tmpfs for dind
if [ -e /dev/cpu_dma_latency ] && [[ "${START_DOCKER,,}" == "true" ]] && [ ! -S /var/run/docker.sock ] \
  && ! mountpoint -q /tmp; then
  mount -t tmpfs none /tmp
fi
# X socket dir
mkdir -p /tmp/.X11-unix
chown root:root /tmp/.X11-unix
chmod 1777 /tmp/.X11-unix

# add games paths
if [[ "${PATH}" != *"games"* ]]; then
  printf "/usr/local/games:/usr/games:${PATH}" > /run/s6/container_environment/PATH
fi

# locale Support
if [ ! -z ${LC_ALL+x} ]; then
  printf "${LC_ALL%.UTF-8}" > /run/s6/container_environment/LANGUAGE
  printf "${LC_ALL}" > /run/s6/container_environment/LANG
  LOCALE_NAME="$(echo "${LC_ALL}" | sed -E 's/\.(UTF-8|utf8)$/.utf8/I')"
  if [[ "${LC_ALL}" != C* ]] && [[ "${LC_ALL}" != POSIX ]] && ! locale -a 2>/dev/null | grep -qixF "${LOCALE_NAME}"; then
    echo "[ls.io-init] Generating locale ${LC_ALL}"
    locale-gen "${LC_ALL}" > /dev/null || echo "[ls.io-init] ${LC_ALL} is not a locale this image can generate"
  fi
fi

# hardening flags
if [[ ${HARDEN_DESKTOP,,} == "true" ]]; then
  export DISABLE_OPEN_TOOLS="true"
  export DISABLE_SUDO="true"
  export DISABLE_TERMINALS="true"
  # application hardening if unset
  if [ -z ${SELKIES_FILE_TRANSFERS+x} ]; then
    printf "" > /run/s6/container_environment/SELKIES_FILE_TRANSFERS
  fi
  if [ -z ${SELKIES_COMMAND_ENABLED+x} ]; then
    printf "false" > /run/s6/container_environment/SELKIES_COMMAND_ENABLED
  fi
  if [ -z ${SELKIES_PRINTING_ENABLED+x} ]; then
    export SELKIES_PRINTING_ENABLED="false"
    printf "false" > /run/s6/container_environment/SELKIES_PRINTING_ENABLED
  fi
  if [ -z ${SELKIES_UI_SIDEBAR_SHOW_FILES+x} ]; then
    printf "false" > /run/s6/container_environment/SELKIES_UI_SIDEBAR_SHOW_FILES
  fi
  if [ -z ${SELKIES_UI_SIDEBAR_SHOW_APPS+x} ]; then
    printf "false" > /run/s6/container_environment/SELKIES_UI_SIDEBAR_SHOW_APPS
  fi
fi
if [ -z "${CUPS_SERVER}" ] && [[ "${SELKIES_PRINTING_ENABLED,,}" != "false" ]]; then
  printf "$HOME/.XDG/selkies-cups/cups.sock" > /run/s6/container_environment/CUPS_SERVER
fi

# upstream selkies now defaults command websocket messages to off, the
# dashboard apps/launcher section depends on them so enable when not hardened
if [[ ${HARDEN_DESKTOP,,} != "true" ]] && [ -z ${SELKIES_COMMAND_ENABLED+x} ]; then
  printf "true" > /run/s6/container_environment/SELKIES_COMMAND_ENABLED
fi
if [[ ${HARDEN_OPENBOX,,} == "true" ]]; then
  export DISABLE_CLOSE_BUTTON="true"
  export DISABLE_MOUSE_BUTTONS="true"
  export HARDEN_KEYBINDS="true"
  if [ -z ${RESTART_APP+x} ]; then
    export RESTART_APP=true
    printf "true" > /run/s6/container_environment/RESTART_APP
  fi
fi

# disable open tools
xdg_open_path=$(which xdg-open 2>/dev/null)
exo_open_path=$(which exo-open 2>/dev/null)
if [[ ${DISABLE_OPEN_TOOLS,,} == "true" ]]; then
  echo "[ls.io-init] Disabling xdg-open and exo-open"
  [ -n "$xdg_open_path" ] && chmod 0000 "$xdg_open_path"
  [ -n "$exo_open_path" ] && chmod 0000 "$exo_open_path"
else
  [ -n "$xdg_open_path" ] && chmod 755 "$xdg_open_path"
  [ -n "$exo_open_path" ] && chmod 755 "$exo_open_path"
fi

# disable sudo
sudo_path=$(which sudo 2>/dev/null)
if [[ ${DISABLE_SUDO,,} == "true" ]]; then
  echo "[ls.io-init] Disabling sudo binary and corrupting sudoers config"
  [ -n "$sudo_path" ] && chmod 0000 "$sudo_path"
  sed -i "s/NOPASSWD/CORRUPT_FILE/g" /etc/sudoers
else
  [ -n "$sudo_path" ] && chmod 4755 "$sudo_path"
  sed -i "s/CORRUPT_FILE/NOPASSWD/g" /etc/sudoers
fi

# disable terminals and menu entries
USER_MENU_DIR="$CONF_DIR"
USER_MENU_XML="$USER_MENU_DIR/menu.xml"
USER_MENU_BAK="$USER_MENU_DIR/menu.xml.bak"
TERMINAL_NAMES=("xterm" "st" "stterm" "uxterm" "lxterminal" "gnome-terminal" "konsole" "xfce4-terminal" "terminator" "foot" "weston-terminal")
if [ -f "$USER_MENU_XML" ] && [ ! -f "$USER_MENU_BAK" ]; then
  echo "[ls.io-init] Creating initial backup of menu.xml"
  cp "$USER_MENU_XML" "$USER_MENU_BAK"
  chown abc:abc "$USER_MENU_BAK"
fi
if [[ ${DISABLE_TERMINALS,,} == "true" ]]; then
  echo "[ls.io-init] Disabling terminal binaries and removing from menu"
  [ -f "$USER_MENU_BAK" ] && cp "$USER_MENU_BAK" "$USER_MENU_XML"
  for term_name in "${TERMINAL_NAMES[@]}"; do
    term_path=$(which "$term_name" 2>/dev/null)
    if [ -n "$term_path" ]; then
      chmod 0000 "$term_path"
      escaped_path=$(echo "$term_path" | sed 's/[&/\]/\\&/g')
      for menu_file in "$USER_MENU_XML" "${SYSTEM_MENUS[@]}"; do
        [ -f "$menu_file" ] && sed -i "/<command>${escaped_path}<\/command>/d" "$menu_file"
      done
    fi
  done
  [ -f "$USER_MENU_XML" ] && chown abc:abc "$USER_MENU_XML"
else
  if [ -f "$USER_MENU_BAK" ]; then
    cp "$USER_MENU_BAK" "$USER_MENU_XML"
    chown abc:abc "$USER_MENU_XML"
  fi
  for term_name in "${TERMINAL_NAMES[@]}"; do
    term_path=$(which "$term_name" 2>/dev/null)
    if [ -n "$term_path" ] && [ ! -x "$term_path" ]; then
      chmod 755 "$term_path"
    fi
  done
fi

# lock down autostart file if auto restart is enabled
AUTOSTART_SCRIPT="$CONF_DIR/autostart"
if [ -f "$AUTOSTART_SCRIPT" ]; then
  if [[ ${RESTART_APP,,} == "true" ]]; then
    echo "[ls.io-init] RESTART_APP is set. Setting autostart owner to root and making read-only for user"
    chown root:abc "$AUTOSTART_SCRIPT"
    chmod 550 "$AUTOSTART_SCRIPT"
  else
    chown abc:abc "$AUTOSTART_SCRIPT"
    chmod 644 "$AUTOSTART_SCRIPT"
  fi
fi

# labwc rc.xml first run
if [[ "${PIXELFLUX_WAYLAND,,}" == "true" ]] && [[ -f "$DEF_RC" ]] && [[ ! -f "$CONF_DIR/rc.xml" ]]; then
  cp "$DEF_RC" "$CONF_DIR/rc.xml"
  chown abc:abc "$CONF_DIR/rc.xml"
fi

# use selkies wm for stock startwm scripts
if [ -z ${SELKIES_WM+x} ]; then
  if [[ "${PIXELFLUX_WAYLAND,,}" == "true" ]]; then
    STARTWM=/defaults/startwm_wayland.sh
  else
    STARTWM=/defaults/startwm.sh
  fi
  if grep -qs '^# selkies-session$' "$STARTWM"; then
    printf "true" > /run/s6/container_environment/SELKIES_WM
  fi
fi

# map legacy wm env vars
set_unset() {
  if [ -z "${!1+x}" ]; then
    printf "%s" "$2" > /run/s6/container_environment/"$1"
    export "$1=$2"
  fi
}
if [[ ${RESTART_APP,,} == "true" ]] && [[ ${EXIT_ON_APP_CLOSE,,} != "true" ]]; then
  set_unset SELKIES_APP_RESTART true
fi
if [[ ! -z ${NO_FULL+x} ]]; then
  set_unset SELKIES_WM_MAXIMIZE false
fi
if [[ ! -z ${NO_DECOR+x} ]]; then
  set_unset SELKIES_WM_DECORATIONS false
fi
if [[ ${DISABLE_WINDOW_BUTTONS,,} == "true" ]]; then
  set_unset SELKIES_WM_BUTTONS none
elif [[ ${DISABLE_CLOSE_BUTTON,,} == "true" ]]; then
  set_unset SELKIES_WM_BUTTONS minimize,maximize
fi
if [[ ${DISABLE_MOUSE_BUTTONS,,} == "true" ]]; then
  set_unset SELKIES_WM_MENUS false
fi
if [[ ${HARDEN_KEYBINDS,,} == "true" ]]; then
  set_unset SELKIES_WM_KEYBINDS false
fi
if [[ ${HARDEN_OPENBOX,,} == "true" ]] || [[ ${HARDEN_DESKTOP,,} == "true" ]]; then
  set_unset SELKIES_SESSION_SWITCH false
fi

# cursor theme
set_unset XCURSOR_THEME breeze_cursors

# ui title, icon and pelorus
if [[ -n "${TITLE}" ]]; then
  set_unset SELKIES_UI_TITLE "${TITLE}"
fi
if [[ -f /usr/share/selkies/www/icon.png ]]; then
  set_unset SELKIES_UI_ICON /usr/share/selkies/www/icon.png
fi
if [[ "${PELORUS,,}" == "true" ]]; then
  set_unset SELKIES_PELORUS true
  set_unset QT_ACCESSIBILITY 1
  set_unset QT_LINUX_ACCESSIBILITY_ALWAYS_ON 1
  set_unset GTK_MODULES gail:atk-bridge
  set_unset MOZ_ENABLE_WAYLAND 0
fi

# brand the on disk web client for external hosts, selkies serves its embedded copy
if [[ -f /usr/share/selkies/web/index.html ]]; then
  if [[ -f /usr/share/selkies/www/icon.png ]]; then
    cp \
      /usr/share/selkies/www/icon.png \
      /usr/share/selkies/web/favicon.ico
    cp \
      /usr/share/selkies/www/icon.png \
      /usr/share/selkies/web/icon.png
  fi
  echo "{
  \"name\": \"${TITLE}\",
  \"short_name\": \"${TITLE}\",
  \"manifest_version\": 2,
  \"version\": \"1.0.0\",
  \"display\": \"fullscreen\",
  \"background_color\": \"#000000\",
  \"theme_color\": \"#000000\",
  \"icons\": [
    {
      \"src\": \"icon.png\",
      \"type\": \"image/png\",
      \"sizes\": \"180x180\"
    }
  ],
  \"start_url\": \"${SUBFOLDER:-/}\"
}" > /usr/share/selkies/web/manifest.json
fi

# add proot-apps
proot_updated=false
if [ ! -f "$HOME/.local/bin/proot-apps" ]; then
  mkdir -p "$HOME/.local/bin/"
  cp /proot-apps/* "$HOME/.local/bin/"
  echo 'export PATH="$HOME/.local/bin:$PATH"' >> "$HOME/.bashrc"
  proot_updated=true
elif ! diff -q /proot-apps/pversion "$HOME/.local/bin/pversion" > /dev/null; then
  cp /proot-apps/* "$HOME/.local/bin/"
  proot_updated=true
fi
# proot doubles as bubblewrap when launched as bwrap
if [ "$(readlink "$HOME/.local/bin/bwrap" 2>/dev/null)" != "proot" ]; then
  ln -sfn proot "$HOME/.local/bin/bwrap"
  proot_updated=true
fi
rm -f "$HOME/.local/bin/proot-bwrap"
if ! grep -qsF 'source <(proot-apps completion bash)' "$HOME/.bashrc"; then
  echo 'source <(proot-apps completion bash)' >> "$HOME/.bashrc"
  chown abc:abc "$HOME/.bashrc"
fi
if [ "$proot_updated" = true ]; then
    chown -R abc:abc "$HOME/.local"
    [ -f "$HOME/.bashrc" ] && chown abc:abc "$HOME/.bashrc"
fi

# bubblewrap stand in
if [ -z ${BWRAP+x} ]; then
  printf "$HOME/.local/bin/bwrap" > /run/s6/container_environment/BWRAP
fi

# steam shim
if [[ "${NO_STEAM,,}" == "true" ]]; then
  rm -f /usr/local/bin/steam
  if grep -qs '#SELKIESSHIM' /usr/bin/steam; then
    rm -f /usr/bin/steam
  fi
elif [ -e /usr/local/bin/steam ] && [ ! -e /usr/bin/steam ]; then
  ln -s /usr/local/bin/steam /usr/bin/steam
fi

# Enable gpu encode if device detected
if ! which nvidia-smi && [ -e "/dev/dri/renderD128" ] && [ ! -e "/dev/dri/renderD129" ] && [ -z ${DRI_NODE+x} ]; then
  printf "/dev/dri/renderD128" > /run/s6/container_environment/DRI_NODE
fi
if [[ "${PIXELFLUX_WAYLAND}" == "true" ]] && [ -e "/dev/dri/renderD128" ] && [ ! -e "/dev/dri/renderD129" ] && [ -z ${DRI_NODE+x} ]; then
  printf "/dev/dri/renderD128" > /run/s6/container_environment/DRI_NODE
  if [ -z ${DRINODE+x} ]; then
    printf "/dev/dri/renderD128" > /run/s6/container_environment/DRINODE
  fi
fi

# js setup
mkdir -pm1777 /dev/input
if [[ -z ${NO_GAMEPAD+x} ]] && mknod /dev/input/js0 c 13 0; then
  printf "/usr/lib/selkies_input_interposer.so:/opt/lib/libudev.so.1.0.0-fake" > /run/s6/container_environment/LD_PRELOAD
  mknod /dev/input/js1 c 13 1
  mknod /dev/input/js2 c 13 2
  mknod /dev/input/js3 c 13 3
  mknod /dev/input/event1000 c 13 1064
  mknod /dev/input/event1001 c 13 1065
  mknod /dev/input/event1002 c 13 1066
  mknod /dev/input/event1003 c 13 1067
  chmod 777 /dev/input/js* /dev/input/event*
elif [[ -z ${NO_GAMEPAD+x} ]] && touch /dev/input/js0; then
  printf "/usr/lib/selkies_input_interposer.so:/opt/lib/libudev.so.1.0.0-fake" > /run/s6/container_environment/LD_PRELOAD
  touch /dev/input/js1
  touch /dev/input/js2
  touch /dev/input/js3
  touch /dev/input/event1000
  touch /dev/input/event1001
  touch /dev/input/event1002
  touch /dev/input/event1003
  chmod 777 /dev/input/js* /dev/input/event*
else
  printf "false|locked" > /run/s6/container_environment/SELKIES_UI_SIDEBAR_SHOW_GAMEPADS
  printf "false|locked" > /run/s6/container_environment/SELKIES_GAMEPAD_ENABLED
  printf "false|locked" > /run/s6/container_environment/SELKIES_ENABLE_PLAYER2
  printf "false|locked" > /run/s6/container_environment/SELKIES_ENABLE_PLAYER3
  printf "false|locked" > /run/s6/container_environment/SELKIES_ENABLE_PLAYER4
  printf "false" > /run/s6/container_environment/SELKIES_GAMEPAD_ON_START
  printf "false" > /run/s6/container_environment/SELKIES_UINPUT_GAMEPAD
fi

# migrate emulator configs from the legacy gamepad id
PAD_FILES=(
  "$HOME/.config/eden/qt-config.ini"
  "$HOME/.config/azahar-emu/qt-config.ini"
  "$HOME/.local/share/xemu/xemu/xemu.toml"
  "$HOME"/.config/Cemu/controllerProfiles/*.xml
  "$HOME/.config/dolphin-emu/GCPadNew.ini"
)
for pad_file in "${PAD_FILES[@]}"; do
  if [[ -f "$pad_file" ]] && grep -qE '(000081b8|00000000)4d6963726f736f6674205800|^Device = SDL/[0-9]+/Microsoft X-Box 360 pad' "$pad_file"; then
    echo "[ls.io-init] Migrating legacy gamepad id in $pad_file"
    sed -i \
      -e 's/000081b84d6963726f736f6674205800/030081b85e0400008e02000014010000/g' \
      -e 's/000000004d6963726f736f6674205800/030000005e0400008e02000014010000/g' \
      -e 's|^\(Device = SDL/[0-9]*\)/Microsoft X-Box 360 pad|\1/Xbox 360 Controller|' \
      "$pad_file"
    chown abc:abc "$pad_file"
  fi
done

# webcam setup, a regular file at /dev/video0 is our own placeholder from an earlier init
if [[ -z ${NO_WEBCAM+x} ]] && { [[ -f /dev/video0 ]] || { [[ ! -e /dev/video0 ]] && { mknod /dev/video0 c 81 0 2>/dev/null || touch /dev/video0 2>/dev/null; }; }; }; then
  chmod 777 /dev/video0
  printf "true" > /run/s6/container_environment/SELKIES_WEBCAM_ENABLED
  printf "true" > /run/s6/container_environment/SELKIES_UI_SIDEBAR_SHOW_WEBCAM
  if [[ -s /run/s6/container_environment/LD_PRELOAD ]]; then
    printf "%s:/usr/lib/selkies_v4l2_interposer.so" "$(cat /run/s6/container_environment/LD_PRELOAD)" > /run/s6/container_environment/LD_PRELOAD
  else
    printf "/usr/lib/selkies_v4l2_interposer.so" > /run/s6/container_environment/LD_PRELOAD
  fi
fi

# do not show webrtc unless user is configuring it and default to it if so
WEBRTC_ENV_VARS=(
  SELKIES_RTC_CONFIG_JSON
  SELKIES_TURN_REST_URI
  SELKIES_TURN_REST_API_KEY
  SELKIES_TURN_REST_USERNAME
  SELKIES_TURN_HOST
  SELKIES_TURN_PORT
  SELKIES_TURN_PROTOCOL
  SELKIES_TURN_TLS
  SELKIES_TURN_SHARED_SECRET
  SELKIES_TURN_USERNAME
  SELKIES_TURN_PASSWORD
  SELKIES_STUN_HOST
  SELKIES_STUN_PORT
  SELKIES_WEBRTC_PUBLIC_IP
  SELKIES_ENABLE_CLOUDFLARE_TURN
  SELKIES_CLOUDFLARE_TURN_TOKEN_ID
  SELKIES_CLOUDFLARE_TURN_API_TOKEN
)
WEBRTC_CONFIGURED="false"
for webrtc_var in "${WEBRTC_ENV_VARS[@]}"; do
  if [[ -n "${!webrtc_var}" ]]; then
    echo "[ls.io-init] ${webrtc_var} is set, enabling WebRTC in the dashboard"
    WEBRTC_CONFIGURED="true"
    break
  fi
done
if [[ "${SELKIES_MODE,,}" == "webrtc" ]]; then
  WEBRTC_CONFIGURED="true"
fi
if [[ "${WEBRTC_CONFIGURED}" == "true" ]]; then
  if [[ -z ${SELKIES_MODE+x} ]]; then
    printf "webrtc" > /run/s6/container_environment/SELKIES_MODE
  fi
  if [[ -z ${SELKIES_ENABLE_DUAL_MODE+x} ]]; then
    printf "true" > /run/s6/container_environment/SELKIES_ENABLE_DUAL_MODE
  fi
elif [[ -z ${SELKIES_ENABLE_DUAL_MODE+x} ]]; then
  printf "false" > /run/s6/container_environment/SELKIES_ENABLE_DUAL_MODE
fi

# legacy selkies env var adapters
if [ ! -z ${SELKIES_H264_CRF+x} ] && [ -z ${SELKIES_VIDEO_CRF+x} ]; then
  printf "${SELKIES_H264_CRF}" > /run/s6/container_environment/SELKIES_VIDEO_CRF
fi
if [ ! -z ${SELKIES_H264_FULLCOLOR+x} ] && [ -z ${SELKIES_VIDEO_FULLCOLOR+x} ]; then
  printf "${SELKIES_H264_FULLCOLOR}" > /run/s6/container_environment/SELKIES_VIDEO_FULLCOLOR
fi
if [ ! -z ${SELKIES_H264_PAINTOVER_CRF+x} ] && [ -z ${SELKIES_VIDEO_PAINTOVER_CRF+x} ]; then
  printf "${SELKIES_H264_PAINTOVER_CRF}" > /run/s6/container_environment/SELKIES_VIDEO_PAINTOVER_CRF
fi
if [ ! -z ${SELKIES_H264_PAINTOVER_BURST_FRAMES+x} ] && [ -z ${SELKIES_VIDEO_PAINTOVER_BURST_FRAMES+x} ]; then
  printf "${SELKIES_H264_PAINTOVER_BURST_FRAMES}" > /run/s6/container_environment/SELKIES_VIDEO_PAINTOVER_BURST_FRAMES
fi
if [ ! -z ${SELKIES_IS_MANUAL_RESOLUTION_MODE+x} ] && [ -z ${SELKIES_MANUAL_RESOLUTION+x} ]; then
  printf "${SELKIES_IS_MANUAL_RESOLUTION_MODE}" > /run/s6/container_environment/SELKIES_MANUAL_RESOLUTION
fi
if [ ! -z ${SELKIES_H264_STREAMING_MODE+x} ]; then
  printf "${SELKIES_H264_STREAMING_MODE}" > /run/s6/container_environment/SELKIES_VIDEO_STREAMING_MODE
fi
if [ ! -z ${SELKIES_CLIPBOARD_ENABLED+x} ] && [ -z ${SELKIES_ENABLE_CLIPBOARD+x} ]; then
  printf "${SELKIES_CLIPBOARD_ENABLED%%|*}" > /run/s6/container_environment/SELKIES_ENABLE_CLIPBOARD
fi
if [[ "${DASHBOARD}" == "selkies-dashboard-wish" ]] && [ -z ${SELKIES_UI_LAYOUT+x} ]; then
  printf "wish,default,edge" > /run/s6/container_environment/SELKIES_UI_LAYOUT
fi
case "${SELKIES_ENCODER}" in
  *x264enc*)
    printf "${SELKIES_ENCODER}" | sed 's/x264enc/h264enc/g' > /run/s6/container_environment/SELKIES_ENCODER
    ;;
esac
